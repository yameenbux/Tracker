flowchart TB
    subgraph SCALE["Weighing in with only a scale"]
        direction LR
        A["<b>Monday</b><br/>84.2 kg"]
        B["<b>Tuesday</b><br/>85.1 kg<br/>salt, water, a late meal"]
        C["<b>Wednesday</b><br/>'it isn't working'<br/><i>the day people give up</i>"]
        A --> B --> C
    end

    subgraph TIDE["The same week in Tidemark"]
        direction LR
        D["<b>Every weigh-in</b><br/>two taps, same time each day"]
        E["<b>Trend weight</b><br/>one odd day can't move it far"]
        F["<b>Honest weekly rate</b><br/>down 0.4 kg a week"]
        G["<b>Against your plan</b><br/>on track, and a goal date"]
        D --> E --> F --> G
    end

    SCALE -.->|"same numbers,<br/>read properly"| TIDE

    classDef core fill:#2A1E45,stroke:#FF6B5E,stroke-width:3px,color:#FBF7F3
    classDef live fill:#E4F7EF,stroke:#12B886,stroke-width:2px,color:#241B33
    classDef dev fill:#FFF3D8,stroke:#D9701F,stroke-width:2px,stroke-dasharray:6 4,color:#241B33
    classDef ext fill:#F0E8E0,stroke:#8F8276,stroke-width:1.5px,color:#241B33
    class A,B,C ext
    class D,E,F,G core
