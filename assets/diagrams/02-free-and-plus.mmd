flowchart TB
    APP["<b>Tidemark</b><br/>one app, on the iPhone"]

    subgraph FREE["Free: the whole core"]
        direction LR
        F1["<b>Today</b><br/>trend, pace, habits"]
        F2["<b>Trend</b><br/>chart, change table,<br/>full history"]
        F3["<b>Your plan</b><br/>goal, pace, breaks,<br/>re-plan from here"]
        F4["<b>Up to 3 habits</b><br/>30-day dot grids"]
        F5["<b>Reminders, Face ID,<br/>backups</b>"]
    end

    subgraph PLUS["Tidemark Plus: £1.99 a month, £11.99 a year or £19.99 once"]
        direction LR
        P1["<b>Medication log</b><br/>doses and reminders"]
        P2["<b>Up to 6 habits</b>"]
        P3["<b>Measurements<br/>and photos</b>"]
        P4["<b>Calories</b><br/>and what you burn"]
        P5["<b>Password-protected<br/>backups</b>"]
    end

    subgraph NEXT["In development"]
        direction LR
        N1["<b>Apple Health</b>"]
        N2["<b>iCloud sync</b>"]
        N3["<b>Widgets</b>"]
    end

    APP --> FREE
    APP --> PLUS
    APP -.-> NEXT

    classDef core fill:#2A1E45,stroke:#FF6B5E,stroke-width:3px,color:#FBF7F3
    classDef live fill:#E4F7EF,stroke:#12B886,stroke-width:2px,color:#241B33
    classDef dev fill:#FFF3D8,stroke:#D9701F,stroke-width:2px,stroke-dasharray:6 4,color:#241B33
    classDef ext fill:#F0E8E0,stroke:#8F8276,stroke-width:1.5px,color:#241B33
    class APP core
    class F1,F2,F3,F4,F5,P1,P2,P3,P4,P5 live
    class N1,N2,N3 dev
