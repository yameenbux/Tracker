{
  "expo": {
    "name": "Plumb",
    "slug": "tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yameenbux.tracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A1E45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yameenbux.tracker"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Plumb"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Plumb uses Face ID to keep your weight and habits private."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Plumb lets you pick progress photos. They stay private inside the app.",
          "cameraPermission": "Plumb uses the camera to take progress photos. They stay private inside the app.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
